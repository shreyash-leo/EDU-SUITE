# Public DNS name. Create an A/AAAA record pointing it to the VPS.
DOMAIN=plan.example.com
WEB_ORIGIN=https://plan.example.com

# Generate independently with URL-safe hexadecimal output: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
S3_ACCESS_KEY=replace-with-a-random-storage-access-key
S3_SECRET_KEY=replace-with-a-long-random-storage-secret

# The public object URL is served through the same HTTPS domain.
S3_PUBLIC_URL=https://plan.example.com/assets
S3_REGION=us-east-1
S3_BUCKET=plan-assets

# Optional operational settings.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
ENABLE_API_DOCS=false
